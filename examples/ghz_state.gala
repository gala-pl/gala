/// GHZ state: three qubits in the entangled state (|000⟩ + |111⟩) / sqrt(2).
fn ghz() -> (Qubit, Qubit, Qubit) quantum {
    let a = qubit()
    let b = qubit()
    let c = qubit()
    h(a)
    let (a, b) = cx(a, b)
    let (a, c) = cx(a, c)
    (a, b, c)
}

fn main() -> Int prob {
    let (a, b, c) = ghz()
    let m1 = measure(a)
    let m2 = measure(b)
    let m3 = measure(c)
    print(m1)
    print(m2)
    print(m3)
    return 0
}
