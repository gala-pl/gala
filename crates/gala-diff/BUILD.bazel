load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "gala_diff",
    crate_name = "gala_diff",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-gir:gala_gir",
        "//crates/gala-sim:gala_sim",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "test",
    crate_name = "gala_diff_test",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        ":gala_diff",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-driver:gala_driver",
        "//crates/gala-gir:gala_gir",
        "//crates/gala-sim:gala_sim",
    ],
)
