load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "gala_lexer",
    crate_name = "gala_lexer",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        "@crates//:logos",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-span:gala_span",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "test",
    crate_name = "gala_lexer_test",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        ":gala_lexer",
        "@crates//:insta",
        "@crates//:logos",
        "@crates//:proptest",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-span:gala_span",
    ],
)
