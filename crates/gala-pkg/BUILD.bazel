load("@crates//:defs.bzl", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "gala_pkg",
    crate_name = "gala_pkg",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    edition = crate_edition(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "gala-pkg",
    crate_name = "gala_pkg",
    srcs = ["src/main.rs"],
    edition = crate_edition(),
    deps = [":gala_pkg"] + all_crate_deps(normal = True),
)

rust_test(
    name = "test",
    crate_name = "gala_pkg_test",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    deps = [
        ":gala_pkg",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-span:gala_span",
    ]
    + all_crate_deps(normal = True)
    + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
