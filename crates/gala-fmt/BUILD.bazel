load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "gala_fmt",
    crate_name = "gala_fmt",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    edition = "2021",
    deps = [
        "//crates/gala-ast:gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-lexer:gala_lexer",
        "//crates/gala-parser:gala_parser",
        "//crates/gala-span:gala_span",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "gala-fmt",
    crate_name = "gala_fmt",
    srcs = glob(["src/main.rs"]),
    edition = "2021",
    deps = [":gala_fmt"],
)

rust_test(
    name = "test",
    crate_name = "gala_fmt_test",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    edition = "2021",
    deps = [
        ":gala_fmt",
        "@crates//:insta",
        "@crates//:proptest",
        "//crates/gala-ast:gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-lexer:gala_lexer",
        "//crates/gala-parser:gala_parser",
        "//crates/gala-span:gala_span",
    ],
)
