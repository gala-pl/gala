load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "gala_ast",
    crate_name = "gala_ast",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-span:gala_span",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "test",
    crate_name = "gala_ast_test",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        ":gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-span:gala_span",
    ],
)
