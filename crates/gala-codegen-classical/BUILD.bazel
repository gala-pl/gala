load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The `classical` feature enables inkwell (LLVM 10). It is off by default so
# `bazel build //...` works without an LLVM toolchain. Enable with:
#   bazel build //crates/gala-codegen-classical --features=classical
rust_library(
    name = "gala_codegen_classical",
    crate_name = "gala_codegen_classical",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        "//crates/gala-ast:gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-gir:gala_gir",
        "//crates/gala-opt:gala_opt",
        "//crates/gala-span:gala_span",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "test",
    crate_name = "gala_codegen_classical_test",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        ":gala_codegen_classical",
        "@crates//:insta",
        "//crates/gala-ast:gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-gir:gala_gir",
        "//crates/gala-hir:gala_hir",
        "//crates/gala-opt:gala_opt",
        "//crates/gala-parser:gala_parser",
        "//crates/gala-sim:gala_sim",
        "//crates/gala-span:gala_span",
        "//crates/gala-types:gala_types",
    ],
)
