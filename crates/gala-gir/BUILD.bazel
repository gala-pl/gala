load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "gala_gir",
    crate_name = "gala_gir",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        "@crates//:petgraph",
        "@crates//:serde",
        "@crates//:serde_json",
        "//crates/gala-ast:gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-hir:gala_hir",
        "//crates/gala-span:gala_span",
        "//crates/gala-types:gala_types",
        "//crates/gala-uncompute:gala_uncompute",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "test",
    crate_name = "gala_gir_test",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        ":gala_gir",
        "@crates//:insta",
        "@crates//:petgraph",
        "@crates//:serde",
        "@crates//:serde_json",
        "//crates/gala-ast:gala_ast",
        "//crates/gala-diagnostics:gala_diagnostics",
        "//crates/gala-hir:gala_hir",
        "//crates/gala-parser:gala_parser",
        "//crates/gala-span:gala_span",
        "//crates/gala-types:gala_types",
        "//crates/gala-uncompute:gala_uncompute",
    ],
)
