{
  "name": "gala-docs",
  "private": true,
  "type": "module",
  "packageManager": "nub@0.8.3",
  "scripts": {
    "build": "nub exec --node next build",
    "dev": "nub exec --node next dev",
    "start": "nub exec --node next start",
    "test": "nub exec --node vitest run",
    "postinstall": "nub exec --node fumadocs-mdx",
    "format": "nub exec --node biome check --write .",
    "format:check": "nub exec --node biome check .",
    "lint": "nub exec --node biome lint --write .",
    "lint:check": "nub exec --node biome lint ."
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "fumadocs-core": "15.1.0",
    "fumadocs-mdx": "11.5.6",
    "fumadocs-ui": "15.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.483.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^3.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
