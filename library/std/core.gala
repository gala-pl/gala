// Gala core library: compiler intrinsics.
//
// A declaration without a body binds to the compiler builtin of the same name, so the signatures
// here are what callers see; the compiler provides the behavior.

/// Allocate one qubit in |0⟩. Effect: quantum.
fn qubit() -> Qubit quantum;

/// Allocate a register of qubits in |0…0⟩. The size is given at the call: `qubits<4>()`.
fn qubits() quantum;

/// Measure a qubit (or a register). The qubit is consumed; the result is a sampled outcome.
/// Effect: prob.
fn measure(q: Qubit) -> Measured<Bool> prob;

/// Release a qubit after the compiler synthesizes its uncomputation. Refused with E0530 when the
/// qubit cannot be returned to |0⟩.
fn drop(q: Qubit) quantum;

/// Print a value to standard output. Effect: pure.
fn print(x: Int) pure;
