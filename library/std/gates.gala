// Gala standard gate set.
//
// Each declaration binds to the compiler's unitary gate of the same name. Gates take qubits and
// return them, so `h(q)` as a statement applies the gate to `q` in place.
//
// Adjoints are derived by the compiler (see the uncomputation pass); they are not declared here.

/// Hadamard: maps |0⟩ to |+⟩.
fn h(q: Qubit) -> Qubit quantum;

/// Pauli X (bit flip).
fn x(q: Qubit) -> Qubit quantum;

/// Pauli Y.
fn y(q: Qubit) -> Qubit quantum;

/// Pauli Z (phase flip).
fn z(q: Qubit) -> Qubit quantum;

/// Phase gate S = diag(1, i).
fn s(q: Qubit) -> Qubit quantum;

/// T gate = diag(1, e^{iπ/4}).
fn t(q: Qubit) -> Qubit quantum;

/// Rotation about X by `theta` radians.
fn rx(q: Qubit, theta: Float) -> Qubit quantum;

/// Rotation about Y by `theta` radians.
fn ry(q: Qubit, theta: Float) -> Qubit quantum;

/// Rotation about Z by `theta` radians.
fn rz(q: Qubit, theta: Float) -> Qubit quantum;

/// Controlled NOT: flips `target` when `control` is 1.
fn cx(control: Qubit, target: Qubit) -> (Qubit, Qubit) quantum;

/// Controlled Z.
fn cz(a: Qubit, b: Qubit) -> (Qubit, Qubit) quantum;

/// Swap two qubits.
fn swap(a: Qubit, b: Qubit) -> (Qubit, Qubit) quantum;

/// Controlled phase: multiplies |11⟩ by e^{iθ}.
fn cp(control: Qubit, target: Qubit, theta: Float) -> (Qubit, Qubit) quantum;
