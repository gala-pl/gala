// Gala variational quantum algorithms: the smallest hybrid building blocks.
//
// A feature is encoded as a rotation; a trainable parameter is a rotation whose angle the
// optimizer learns (see `gala-diff`, which differentiates these by the parameter-shift rule).

/// Angle encoding: rotate the qubit by the feature value.
fn angle_encode(q: Qubit, x: Float) -> Qubit quantum {
    ry(q, x)
}

/// Trainable ansatz: one rotation by the learned parameter.
fn ansatz(q: Qubit, theta: Float) -> Qubit quantum {
    ry(q, theta)
}

/// A one-qubit classifier. The probability of `true` is (1 − ⟨Z⟩) / 2 of the encoded state.
fn classify(x: Float, theta: Float) -> Measured<Bool> prob {
    let q = qubit()
    let q = angle_encode(q, x)
    let q = ansatz(q, theta)
    measure(q)
}
